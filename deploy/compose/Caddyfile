# TLS in front of Altiward (docs/install.md). Caddy gets and renews certificates itself
# when both hostnames resolve to this server and ports 80 and 443 reach it.

# Public: Macs report here from any network. Nothing but the agent endpoints gets through.
{$ALTIWARD_AGENT_HOST} {
	@agent path /v1/agent/*
	handle @agent {
		reverse_proxy altiward:8080
	}
	handle {
		respond 404
	}
}

# The console and its API, only from the networks in ALTIWARD_CONSOLE_ALLOW (your office
# or VPN ranges, space separated).
{$ALTIWARD_CONSOLE_HOST} {
	@allowed remote_ip {$ALTIWARD_CONSOLE_ALLOW}
	handle @allowed {
		reverse_proxy altiward:8080
	}
	handle {
		respond 403
	}
}
