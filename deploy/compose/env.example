# Copy to .env next to compose.yaml and fill in. Keep .env private: it holds every secret.

# The release to run, for example 0.1.0. ./upgrade.sh changes it for you
# (docs/install.md, "Releases and updates").
ALTIWARD_VERSION=

# Hostnames that resolve to this server. Macs report to the agent host; people use the
# console host.
ALTIWARD_AGENT_HOST=altiward-agents.example.com
ALTIWARD_CONSOLE_HOST=altiward.example.com

# Networks allowed to open the console, space separated (office and VPN ranges).
ALTIWARD_CONSOLE_ALLOW=10.0.0.0/8 192.168.0.0/16

# Letters and digits only, so it fits in a connection URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# One organisation name, then a token of at least 16 characters: openssl rand -hex 24
# The agent token goes into the Mac profile as EnrollmentToken; the console token is how
# people sign in to the console, or a break-glass login once single sign-on is set up.
ALTIWARD_AGENT_TOKENS=yourcompany=
ALTIWARD_CONSOLE_TOKENS=yourcompany=

# Every setting below is off while it's empty. Set them here, never in compose.yaml, so
# upgrades can replace compose.yaml. Apply a change with: docker compose up -d

# Single sign-on for the console. The console token above then becomes a break-glass
# login. The redirect URL is https://<console host>/v1/auth/callback.
# ALTIWARD_OIDC_ISSUER=https://login.microsoftonline.com/<directory ID>/v2.0
# ALTIWARD_OIDC_CLIENT_ID=
# ALTIWARD_OIDC_CLIENT_SECRET=
# Group IDs (Entra) or names (Okta) for each role, comma separated.
# ALTIWARD_OIDC_ADMIN_GROUPS=
# ALTIWARD_OIDC_OPERATOR_GROUPS=
# ALTIWARD_OIDC_VIEWER_GROUPS=
# Okta: openid email profile groups
# ALTIWARD_OIDC_SCOPES=
# The claim holding groups: groups (default), or roles for Entra app roles.
# ALTIWARD_OIDC_GROUPS_CLAIM=
# Only if the tokens above name more than one organisation.
# ALTIWARD_OIDC_TENANT=

# Days to keep the log of console activity, at least 365. Leave empty to keep it forever.
# ALTIWARD_AUDIT_RETENTION_DAYS=

# The console tells admins when a newer server or agent is out: their browser asks
# api.github.com for the release list, and the server contacts nobody. false turns it off.
# ALTIWARD_UPDATE_CHECK=

# SIEM export: set the ones you use (integrations/<siem>/README.md).
# ALTIWARD_SPLUNK_HEC_URL=https://splunk.example.com:8088
# ALTIWARD_SPLUNK_HEC_TOKEN=
# ALTIWARD_SPLUNK_INDEX=
# ALTIWARD_SENTINEL_ENDPOINT=
# ALTIWARD_SENTINEL_DCR_ID=
# On an Azure VM, managed-identity signs in as the VM, with no tenant ID or secret; set
# CLIENT_ID only for a user-assigned identity. Elsewhere, certificate signs in with the
# app's certificate instead of a secret: CERTIFICATE_FILE is a PEM file with the
# certificate and its private key, in certs/, such as /etc/altiward/certs/sentinel.pem.
# Default: secret.
# ALTIWARD_SENTINEL_AUTH=
# ALTIWARD_SENTINEL_TENANT_ID=
# ALTIWARD_SENTINEL_CLIENT_ID=
# ALTIWARD_SENTINEL_CLIENT_SECRET=
# ALTIWARD_SENTINEL_CERTIFICATE_FILE=
# ALTIWARD_SENTINEL_STREAM=
# ALTIWARD_SYSLOG_ADDR=siem.example.com:6514
# ALTIWARD_SYSLOG_TLS=
# A CA file you put in certs/, such as /etc/altiward/certs/syslog-ca.pem: the only CA
# trusted for syslog. Most sites need ALTIWARD_TRUSTED_CAS_FILE below instead.
# ALTIWARD_SYSLOG_CA_FILE=
# ALTIWARD_SYSLOG_FORMAT=
# ALTIWARD_SYSLOG_FRAMING=

# If your SIEM's or identity provider's certificate comes from your own CA, put that CA's
# PEM file in certs/ and name it here, such as /etc/altiward/certs/internal-ca.pem. It's
# trusted alongside the public CAs.
# ALTIWARD_TRUSTED_CAS_FILE=
