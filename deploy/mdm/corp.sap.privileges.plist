<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys to ADD to your existing SAP Privileges profile (domain corp.sap.privileges).
  Upload as custom settings (Jamf Pro: Application & Custom Settings; Intune: preference file).
  Altiward never ships or modifies Privileges itself; it only asks for these keys.

  PostChangeExecutableChecksum must be the SHA-256 of the signed hook binary
  for the agent version being deployed:
    shasum -a 256 "/Library/Application Support/Altiward/Altiward.app/Contents/MacOS/Altiward"
  Privileges refuses to run the hook if it does not match, which pins the binary.
  The hook is installed as "Altiward", the name Privileges shows in its settings.

  EnableSystemExtension turns on Privileges' own tamper protection (Privileges 2.5.0 or
  later, macOS 13 or later). Altiward raises a High alert while it is off or the extension
  isn't running. The extension also needs, from your MDM: a system extension policy
  allowing SAP's team 7R5ZEU67FQ (Endpoint Security extension) and Full Disk Access for
  corp.sap.privileges.extension.
  SAP's Example_ApprovePrivileges.mobileconfig has both.

  The keys after EnableSystemExtension are settings Altiward relies on. Privileges lets
  users change any setting its profile doesn't set, so Altiward reports each Mac where
  the profile doesn't set them (docs/install.md, step 2):
  - ExpirationIntervalMax caps how long a grant lasts. Use your own policy's value, or
    a fixed ExpirationInterval instead if your profile already sets one.
  - AllowPrivilegeRenewal false: a renewal doesn't reach Altiward, so expiry
    enforcement would remove renewed rights early. Don't set AutoRenewalProcessPaths,
    which renews whatever this says.
  - PostChangeActionOnGrantOnly false: Privileges then runs the hook when rights are
    given back too, and a user can't tick "Run only if administrator privileges have
    been granted".
-->
<plist version="1.0">
<dict>
    <key>PostChangeExecutablePath</key>
    <string>/Library/Application Support/Altiward/Altiward.app/Contents/MacOS/Altiward</string>
    <key>PostChangeExecutableChecksum</key>
    <string>REPLACE_WITH_SHA256_OF_SIGNED_HOOK</string>
    <key>PassReasonToExecutable</key>
    <true/>
    <key>EnableSystemExtension</key>
    <true/>
    <key>ExpirationIntervalMax</key>
    <integer>60</integer>
    <key>AllowPrivilegeRenewal</key>
    <false/>
    <key>PostChangeActionOnGrantOnly</key>
    <false/>
    <!-- Recommended, once you have listed your permanent admins: rights never survive a
         restart or a clock set back. Each exclusion list must name every account in
         Altiward's PermanentAdmins (break-glass, LAPS, your MDM's admin): Privileges makes
         any other admin a standard user at their next sign-in, or when the clock changes.
         Altiward reports a Mac where a list leaves one out.
    <key>RevokePrivilegesAtLogin</key>
    <true/>
    <key>RevokeAtLoginExcludedUsers</key>
    <array>
        <string>REPLACE_WITH_EACH_PERMANENT_ADMIN</string>
    </array>
    <key>RevokePrivilegesAfterSystemTimeChange</key>
    <true/>
    <key>RevokeAfterTimeChangeExcludedUsers</key>
    <array>
        <string>REPLACE_WITH_EACH_PERMANENT_ADMIN</string>
    </array>
    -->
    <!-- Suggested, if your Privileges profile doesn't already set them: Privileges keeps a
         reason only when it requires one, so without these Altiward records no reason.
    <key>ReasonRequired</key>
    <true/>
    <key>ReasonMinLength</key>
    <integer>10</integer>
    -->
</dict>
</plist>
